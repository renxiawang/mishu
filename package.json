{
  "name": "slack-coding-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Slack-native coding agent — a router that delegates Slack threads to a coding-agent CLI in an isolated sandbox.",
  "license": "MIT",
  "bin": {
    "slack-coding-agent": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:live": "SBX_LIVE=1 vitest run --config vitest.live.config.ts",
    "check": "biome check --error-on-warnings . && tsc --noEmit && vitest run",
    "check:fix": "biome check --write --error-on-warnings . && tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.16.0"
  }
}
